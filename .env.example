# Copy to .env and fill in. Variables already set in your shell win over .env.
# See README for provider examples (OpenAI, Claude, DeepSeek, OpenRouter, Ollama).

# Required for non-dry runs
LLM_API_KEY=
LLM_MODEL=

# openai (default) or anthropic
LLM_PROVIDER=openai

# Optional API root override (e.g. https://api.deepseek.com, https://openrouter.ai/api/v1)
# LLM_BASE_URL=

# Max completion tokens per call (OpenAI-compatible and Anthropic). Default 8192.
# LLM_MAX_OUTPUT_TOKENS=8192

# Per-request timeout in ms (default 600000 = 10 minutes). Raise for slow thinking models.
# LLM_REQUEST_TIMEOUT_MS=600000

# DeepSeek thinking mode: disabled | enabled. DeepSeek base URLs default to disabled.
# LLM_THINKING=disabled

# Sampling temperature (default 0). Set to "none" to omit the parameter entirely.
# LLM_TEMPERATURE=0

# Independent review passes for agreement scoring (1-5, default 2). Later runs use CONSISTENCY_TEMPERATURE.
# When ≥2 and all batches succeed, only findings seen in multiple runs are published.
# CONSISTENCY_RUNS=2
# CONSISTENCY_TEMPERATURE=0.4

# Confidence floor for inline comments (0..1). Inline also requires severity critical or high
# (medium/low/info stay in the review overview only).
# MINIMUM_CONFIDENCE=0.85

# Max annotated chars packed per API call (default 100000).
# BATCH_CHARS=100000
# Max chars per file piece before hunk-splitting (default 20000). Large files are split even
# when under BATCH_CHARS, and split parts are not packed back together.
# PIECE_CHARS=20000
